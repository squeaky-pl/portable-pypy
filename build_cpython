#!/bin/bash

set -e

if [[ $ABI == "32" ]]; then
    export CFLAGS="-m32 $CFLAGS"
    export CPPFLAGS=$CFLAGS
    export LDFLAGS="-m32 $LDFLAGS"
fi

env
set -x

rm -rf Python-2.7.10
wget -c https://www.python.org/ftp/python/2.7.10/Python-2.7.10.tgz
tar xof Python-2.7.10.tgz

cd Python-2.7.10
./configure --prefix=/opt/prefix/cpython-2.7
make "-j${MAKE_PROCS}"
make install
